{
  "name": "clone-tabnews-evol",
  "version": "1.0.0",
  "description": "Este repositório, diferente dos repositórios de reviews (rw) será  evoluído (evol) de acordo com o projeto original.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run service:up && next dev",
    "service:up": "docker compose -f infra/compose.yaml up -d",
    "service:stop": "docker compose -f infra/compose.yaml stop -d",
    "service:down": "docker compose -f infra/compose.yaml down",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watchAll",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv-expand": "^12.0.2",
    "next": "^15.3.1",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.15.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prettier": "^3.5.3"
  }
}
